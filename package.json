    "release:win-setup": "node scripts/build-windows-installer.js",
    "desktop:dev": "electron .",
    "desktop:tauri:dev": "tauri dev",
    "release:desktop": "node scripts/build-electron.js",
    "release:desktop:portable": "node scripts/build-electron.js",
    "release:desktop:installer": "node scripts/build-electron.js --installer",
    "release:tauri": "tauri build",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-tauri-backend.js",
    "test": "echo \"no tests yet\" && exit 0",
